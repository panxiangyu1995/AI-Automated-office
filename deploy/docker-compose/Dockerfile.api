FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Debug build: add -tags debug to enable debug endpoints
# RUN CGO_ENABLED=0 GOOS=linux go build -tags debug -o /bin/api ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/api ./cmd/server

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /bin/api /usr/local/bin/api
EXPOSE 8080
CMD ["api"]
