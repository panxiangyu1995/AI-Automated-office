# ============================================
# AI-Automated-office 环境变量配置
# ============================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ---- 数据库配置 ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_office
DB_PASSWORD=ai_office_pass
DB_NAME=ai_office

# ---- Redis 配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- API 服务配置 ----
API_HOST=0.0.0.0
API_PORT=8080
API_MODE=release

# ---- JWT 配置 ----
JWT_SECRET=change-me-in-production

# ---- Nginx 配置 ----
NGINX_PORT=80
