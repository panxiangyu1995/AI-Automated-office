FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Debug build: add -tags debug to enable debug commands
# RUN CGO_ENABLED=0 GOOS=linux go build -tags debug -o /bin/ao-cli .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/ao-cli .

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /bin/ao-cli /usr/local/bin/ao-cli
ENTRYPOINT ["ao-cli"]
