FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /build

COPY cli/go.mod cli/go.sum ./
RUN go mod download

COPY cli/ .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -installsuffix cgo -o /app/ao-cli ./main.go

FROM alpine:3.19

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /app/ao-cli .

ENTRYPOINT ["/app/ao-cli"]
CMD ["--help"]
